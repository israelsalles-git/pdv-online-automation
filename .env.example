# Copie para .env (cp .env.example .env) e ajuste. O .env real nunca deve ir para o Git.

# Sistema sob teste. Por padrão aponta para o demo_app local.
BASE_URL=http://127.0.0.1:5055
API_URL=http://127.0.0.1:5055/api

# Credenciais usadas pelos testes (e pelo demo_app como usuário válido).
# Valores de DEMONSTRAÇÃO - troque ao apontar para outro sistema.
TEST_USERNAME=admin
TEST_PASSWORD=123456

# Navegador dos testes UI: chrome | firefox
BROWSER=chrome
# true em CI / false para ver o navegador durante o desenvolvimento
HEADLESS=true

# true: sobe o demo_app automaticamente se nada responder em BASE_URL
START_DEMO_APP=true
# Timeout (segundos) para esperas do Selenium e requisições HTTP
TIMEOUT=10
# DEBUG | INFO | WARNING
LOG_LEVEL=INFO
